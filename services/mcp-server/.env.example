# Copy to .env for local development. Never commit the real .env.

# --- Server ---------------------------------------------------------------
# Shared secret clients must send as: Authorization: Bearer <token>
# Leave empty to disable auth entirely (local dev only).
MCP_AUTH_TOKEN=

MCP_SERVER_NAME=mcp-server
MCP_LOG_LEVEL=info

# HTTP port. Cloud Run sets PORT automatically; this is the local fallback.
PORT=8080

# --- Document corpus (Neon Postgres + pgvector) ---------------------------
# Use Neon's POOLED connection string (the one with "-pooler" in the host).
# Must include ?sslmode=require. Quote it if you ever `source` this file —
# the & in the query string is a shell operator.
MCP_DATABASE_URL=

# Embeddings only — this server never calls a chat model.
MCP_OPENAI_API_KEY=
# Leave empty for OpenAI. Set to another OpenAI-compatible gateway
# (e.g. https://openrouter.ai/api/v1) to use a single key.
MCP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
MCP_EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the vector(N) column. Changing it requires re-embedding everything.
MCP_EMBEDDING_DIMENSIONS=1536

MCP_CHUNK_TOKENS=512
MCP_CHUNK_OVERLAP_TOKENS=64
MCP_MAX_UPLOAD_BYTES=26214400

# --- Web search -----------------------------------------------------------
# https://tavily.com — free tier is generous.
MCP_TAVILY_API_KEY=
