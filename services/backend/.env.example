# Copy to .env for local development. Never commit the real .env.

# --- Model (via OpenRouter) -----------------------------------------------
# https://openrouter.ai/keys
AGENT_OPENROUTER_API_KEY=

# OpenRouter speaks the OpenAI API. Point this elsewhere to switch providers.
AGENT_BASE_URL=https://openrouter.ai/api/v1

# MUST support tool calling, or the agent cannot reach any MCP tool.
# Cheap options ($/Mtok in / out), all tool-capable:
#   qwen/qwen3.7-flash              0.030 / 0.130   1M ctx   <- default
#   deepseek/deepseek-v4-flash-0731 0.040 / 0.080   1.3M ctx
#   openai/gpt-oss-120b             0.037 / 0.170   131K ctx
#   mistralai/mistral-nemo          0.019 / 0.030   131K ctx  (weakest at multi-step)
# Stronger, pricier:
#   openai/gpt-5-mini               0.250 / 2.000
#   anthropic/claude-haiku-4.5      1.000 / 5.000
AGENT_MODEL=qwen/qwen3.7-flash

AGENT_MAX_TOKENS=8000
AGENT_TEMPERATURE=0.0

# Shown on your OpenRouter dashboard for attribution.
AGENT_APP_URL=http://localhost:3000
AGENT_APP_TITLE=Research Agent

# --- MCP server -----------------------------------------------------------
# Local:    http://127.0.0.1:8080/mcp
# Deployed: https://mcp-server-204906671780.us-central1.run.app/mcp
AGENT_MCP_URL=http://127.0.0.1:8080/mcp
# gcloud secrets versions access latest --secret=mcp-auth-token --project=mcp-server-7f2a91
AGENT_MCP_TOKEN=

AGENT_MAX_TOOL_ITERATIONS=24
AGENT_CORS_ORIGINS=http://localhost:3000
PORT=8000
AGENT_LOG_LEVEL=info
