# Copy to .env for local development. Never commit the real .env.

# --- Model ----------------------------------------------------------------
AGENT_ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_MAX_TOKENS=16000
# Thinking depth: low | medium | high | xhigh | max
AGENT_EFFORT=high

# --- MCP server -----------------------------------------------------------
# Local:    http://127.0.0.1:8080/mcp
# Deployed: https://mcp-server-204906671780.us-central1.run.app/mcp
AGENT_MCP_URL=http://127.0.0.1:8080/mcp
# gcloud secrets versions access latest --secret=mcp-auth-token --project=mcp-server-7f2a91
AGENT_MCP_TOKEN=

AGENT_MAX_TOOL_ITERATIONS=24
AGENT_CORS_ORIGINS=http://localhost:3000
PORT=8000
AGENT_LOG_LEVEL=info
