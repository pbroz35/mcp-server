# Copy to .env for local development. Never commit the real .env.

# Shared secret clients must send as: Authorization: Bearer <token>
# Leave empty to disable auth entirely (local dev only).
MCP_AUTH_TOKEN=

# Human-readable server name advertised to MCP clients.
MCP_SERVER_NAME=mcp-server

# HTTP port. Cloud Run sets PORT automatically; this is the local fallback.
PORT=8080

# debug | info | warning | error
MCP_LOG_LEVEL=info
